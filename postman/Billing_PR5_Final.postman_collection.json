              "} else {",
              "    const j = pm.response.json();",
              "    pm.test(\"Tài khoản fixture là CUSTOMER\", function () { pm.expect(j.role).to.eql(\"CUSTOMER\"); });",
              "    pm.test(\"ID CUSTOMER là UUID\", function () { pm.expect(j.id).to.match(/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/); });",
              "    if (j.role !== \"CUSTOMER\" || typeof j.id !== \"string\") {",
              "        pm.execution.setNextRequest(null);",
              "    } else {",
              "        pm.variables.set(\"customer_id\", j.id);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "response": []
