              "    pm.test(\"Role CUSTOMER đã xác thực\", function () { pm.expect(j.role).to.eql(\"CUSTOMER\"); });",
              "    pm.test(\"Login đúng CUSTOMER fixture\", function () { pm.expect(j.userId).to.eql(pm.variables.get(\"customer_id\")); });",
              "    if (j.role !== \"CUSTOMER\" || typeof j.accessToken !== \"string\") {",
              "        pm.execution.setNextRequest(null);",
