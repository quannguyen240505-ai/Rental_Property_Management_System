            "value": "{{internalServiceKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/internal/auth/introspect",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "internal",
            "auth",
            "introspect"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "description": "Correct X-Service-Key + valid JWT. Assert active, UUID, username, role, expiration.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{intJwt0}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test('active = true', () => pm.expect(d.active).to.eql(true));",
              "pm.test('Identity and role agree with login', () => {",
              " pm.expect(d.userId).to.eql(pm.collectionVariables.get('intCustomerId'));",
              " pm.expect(d.username).to.eql(pm.collectionVariables.get('intUsername'));",
              " pm.expect(d.role).to.eql('CUSTOMER');",
              " pm.expect(d.expiresAt).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
