    {
      "name": "TC_INT_008 | Modified signature => inactive",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "X-Service-Key",
            "value": "{{internalServiceKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/internal/auth/introspect",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "internal",
            "auth",
            "introspect"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "description": "Before: tamper JWT signature. After: assert active=false, no identity disclosed.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{intTamperedJwt}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Before request: change the first signature character (not only trailing pad bits).",
              "const token = pm.collectionVariables.get('intJwt0') || '';",
              "const parts = token.split('.');",
              "if (parts.length === 3 && parts[2].length > 1) {",
              " const original = parts[2][0];",
              " parts[2] = (original === 'A' ? 'B' : 'A') + parts[2].slice(1);",
              " pm.collectionVariables.set('intTamperedJwt', parts.join('.'));",
              "} else {",
              " pm.collectionVariables.set('intTamperedJwt', 'not.a.valid.jwt');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test('active = false', () => pm.expect(d.active).to.eql(false));",
              "pm.test('No identity returned', () => { pm.expect(d.userId).to.be.null;pm.expect(d.role).to.be.null; });"
            ]
          }
        }
      ]
    },
