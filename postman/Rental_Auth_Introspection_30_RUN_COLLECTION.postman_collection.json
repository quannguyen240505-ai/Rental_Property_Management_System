              "const d = pm.response.json();",
              "pm.test('CUSTOMER JWT issued', () => { pm.expect(d.role).to.eql('CUSTOMER');pm.expect(d.accessToken).to.be.a('string').and.not.empty;pm.expect(d.userId).to.eql(pm.collectionVariables.get('intCustomerId'));});",
