{
  "info": {
    "_postman_id": "f4109926-4c9a-42c6-9c69-e689776c4d6b",
    "name": "Rental Auth - Introspection 30 Tests - RUN COLLECTION",
    "description": "Standalone Postman collection with 30 sequential requests at collection root. Select collection menu > Run collection. No folder-run necessary. Requires environment variables: baseUrl, ownerUsername, ownerPassword, internalServiceKey.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC_INT_001 | Setup QA data and health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "description": "Before: generate unique QA username/email and reset previous folder tokens. After: check health and service key exists."
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Before request: prepare independent QA identities for this folder.",
              "const id = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);",
              "const vars = ['intCustomerId', 'intJwt0', 'intJwt1', 'intJwt2', 'intJwt3', 'intJwt4', 'intJwt5', 'intJwt6', 'intOwnerToken', 'intTamperedJwt'];",
              "vars.forEach(k => pm.collectionVariables.unset(k));",
              "pm.collectionVariables.set('intRunId', id);",
              "pm.collectionVariables.set('intUsername', 'qa_int_' + id);",
              "pm.collectionVariables.set('intEmail', 'qa_int_' + id + '@example.com');",
              "pm.collectionVariables.set('intPassword', 'Customer@12345');",
              "pm.collectionVariables.set('intNewPassword', 'NewCustomer@12345');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Health UP', () => pm.expect(pm.response.json().status).to.eql('UP'));",
              "pm.test('Service key configured (>= 32 characters)', () => {",
              " const key = pm.variables.get('internalServiceKey');",
              " pm.expect(key, 'Set internalServiceKey in active Postman Environment').to.be.a('string').and.to.have.lengthOf.at.least(32);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "TC_INT_002 | Register disposable CUSTOMER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "description": "Before: use unique credentials prepared in INT_001. After: assert CUSTOMER, store intCustomerId.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{intUsername}}\",\n  \"password\": \"{{intPassword}}\",\n  \"fullName\": \"Introspection QA Customer\",\n  \"email\": \"{{intEmail}}\",\n  \"phone\": \"0901234987\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const d = pm.response.json();",
              "pm.test('Role CUSTOMER and ACTIVE', () => {pm.expect(d.role).to.eql('CUSTOMER');pm.expect(d.status).to.eql('ACTIVE');pm.expect(d.id).to.be.a('string').and.not.empty;});",
              "if (pm.response.code === 201 && d.id) pm.collectionVariables.set('intCustomerId', d.id);"
            ]
          }
        }
      ]
    },
