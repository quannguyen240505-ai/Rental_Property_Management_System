    {
      "name": "GW_12 | Client spoofed OWNER headers still -> 403",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Role",
            "value": "OWNER",
            "type": "text"
          },
          {
            "key": "X-User-Id",
            "value": "00000000-0000-0000-0000-000000000001",
            "type": "text"
          },
          {
            "key": "X-Username",
            "value": "owner",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        },
        "description": "Client-provided internal identity headers must not elevate a CUSTOMER to OWNER.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{gwTestToken}}",
