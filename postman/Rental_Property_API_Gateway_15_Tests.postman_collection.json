    {
      "name": "GW_13 | Internal introspection denied via Gateway -> 403",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/internal/auth/introspect",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "internal",
            "auth",
            "introspect"
          ]
        },
        "description": "Valid customer bearer is provided to distinguish denyAll 403 from unauthenticated 401. No real service key is transmitted.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{gwTestToken}}",
              "type": "string"
            }
