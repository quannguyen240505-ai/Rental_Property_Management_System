    {
      "name": "GW_10 | Tampered signature -> 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "me"
          ]
        },
        "description": "GW_10 | Tampered signature -> 401",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{gwTamperedToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jwt = pm.collectionVariables.get(\"gwTestToken\");",
              "if (!jwt || jwt.split(\".\").length !== 3) { throw new Error(\"GW_06 must run successfully first\"); }",
              "const segments = jwt.split(\".\");",
              "segments[2] = (segments[2][0] === \"A\" ? \"B\" : \"A\") + segments[2].slice(1);",
              "pm.collectionVariables.set(\"gwTamperedToken\", segments.join(\".\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
