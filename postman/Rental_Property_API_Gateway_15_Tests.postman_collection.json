    {
      "name": "GW_04 | Register unique CUSTOMER -> 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Creates a unique test CUSTOMER on local/test database; must run whole collection in order.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{gwTestUsername}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"fullName\": \"Gateway Integration Test\",\n  \"email\": \"{{gwTestEmail}}\",\n  \"phone\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const password = pm.environment.get(\"customerPassword\");",
              "if (!password) { throw new Error(\"Set customerPassword in the selected Postman environment before running\"); }",
              "const runId = Date.now().toString(36) + Math.floor(Math.random() * 100000).toString(36);",
              "pm.collectionVariables.set(\"gwTestUsername\", \"gwtest_\" + runId);",
              "pm.collectionVariables.set(\"gwTestEmail\", \"gwtest_\" + runId + \"@example.invalid\");",
              "pm.collectionVariables.unset(\"gwTestToken\");",
              "pm.collectionVariables.unset(\"gwTamperedToken\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Created user has CUSTOMER role\", () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data.role).to.eql(\"CUSTOMER\");",
              "  pm.expect(data.username).to.eql(pm.collectionVariables.get(\"gwTestUsername\"));",
              "});"
            ]
          }
        }
      ]
    },
