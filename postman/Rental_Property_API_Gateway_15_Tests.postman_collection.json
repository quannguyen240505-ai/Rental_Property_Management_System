        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{gwTestToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Profile matches newly registered user\", () => {",
              "  pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get(\"gwTestUsername\"));",
              "});"
            ]
          }
        }
      ]
    },
