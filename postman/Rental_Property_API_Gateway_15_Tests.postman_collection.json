    },
    {
      "name": "GW_06 | Login new CUSTOMER -> 200 + JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "GW_06 | Login new CUSTOMER -> 200 + JWT",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{gwTestUsername}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JWT returned and CUSTOMER role preserved\", () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data.accessToken).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(data.role).to.eql(\"CUSTOMER\");",
              "  pm.collectionVariables.set(\"gwTestToken\", data.accessToken);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GW_07 | GET /api/users/me valid JWT -> 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/me",
          "host": [
            "{{baseUrl}}"
