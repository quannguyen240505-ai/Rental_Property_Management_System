{
  "info": {
    "name": "Rental Property - API Gateway Integration (15 Tests)",
    "description": "15 ordered Postman requests for API Gateway port 8080 -> Auth Service port 8081. Requires Eureka, Auth, Gateway running and local/test DB. Uses customerPassword from selected environment; registers a new CUSTOMER each run. Manual outage/service-key tests are documented separately. Do NOT run with production DB. No secrets embedded.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GW_01 | Gateway health -> 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        },
        "description": "GW_01 | Gateway health -> 200",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Health is UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "GW_02 | Public login wrong credentials -> 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Public endpoint must reach Auth even when credentials are wrong; response comes from Auth.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"gw_missing_user_123456789\", \"password\": \"DeliberatelyWrong_123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"Auth returns INVALID_CREDENTIALS\", () => pm.expect(pm.response.json().code).to.eql(\"INVALID_CREDENTIALS\"));"
            ]
          }
        }
      ]
    },
